[Unit]
Description=Escuela Modelo AC - isolated production stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/gaibarra/modeloac
ExecStart=/usr/bin/docker compose --env-file .env.production -f compose.production.yml up -d --no-build
ExecStop=/usr/bin/docker compose --env-file .env.production -f compose.production.yml stop
TimeoutStartSec=180
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
